# Disposable execution workspaces (recreated by SubjectRunner.prepare())
.placebo-ws/
.placebo-cache/
.benchmarks/
__pycache__/
*.pyc
.pytest_cache/
.coverage
.placebo-cov.json

# Keep artifacts/, experiments/ and trajectories/ — they ARE the evidence.

# Presentation material - kept local, not part of the published project
docs/VIDEO_SCRIPT.md
docs/DEMO_RUNBOOK.md

# Raw run logs (large, regenerable by rerunning the scripts)
artifacts/*.log

# Editable-install metadata, regenerated by `pip install -e .`
*.egg-info/
*.egg
build/
dist/
*.sarif

# Fault maps produced by the layout and end-to-end tests. They are named
# after throwaway fixture repositories and must never be committed.
artifacts/census_lay*.json
artifacts/census_doc*.json
artifacts/census_cen*.json
artifacts/census_aud*.json
artifacts/census_all*.json
artifacts/census_clie2e*.json
artifacts/survivor_triage_clie2e*.json
*.log
.placebo-external/
